{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext", // needed for import attributes (`with { type: "json" }`, S2's schema.json imports) -- pairs fine with moduleResolution: Bundler
    "moduleResolution": "Bundler",
    // "/experimental" (not the bare package, which resolves to its older
    // stable index.d.ts with no exports/types/main field) is what carries
    // `ScheduledController` and `Fetcher.scheduled()` (S5). A superset of
    // the stable surface, so nothing that typechecked before stops.
    "allowImportingTsExtensions": true, // S3: formats/akl/1's internal imports carry explicit .ts extensions so scripts/goldens.mjs (plain Node) can resolve them -- safe with noEmit above
    "types": ["@cloudflare/workers-types/experimental", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["*.ts", "src/**/*.ts", "formats/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"]
}
