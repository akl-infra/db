{
  "request": {
    "method": "POST",
    "path": "/v1/webhooks",
    "bearer": "conformance-ratelimited-token",
    "body": { "url": "https://receiver.example/hook", "secret": "conformance-webhook-secret-1" }
  },
  "response": {
    "status": 429,
    "headers": { "Content-Type": "application/json", "Retry-After": "600" },
    "body": { "error": "rate_limited", "message": "rate limit exceeded: 60 writes per 600s", "limit": 60, "window_seconds": 600, "retry_after": 600, "scope": "actor" }
  }
}
