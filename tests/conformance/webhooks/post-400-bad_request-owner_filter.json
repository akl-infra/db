{
  "request": {
    "method": "POST",
    "path": "/v1/webhooks",
    "bearer": "conformance-owner2-token",
    "body": { "url": "https://receiver.example/hook", "secret": "conformance-webhook-secret-1", "owner_filter": "not-a-snowflake" }
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "body": { "error": "bad_request", "message": "invalid 'owner_filter' (expected a Discord user id)", "param": "/owner_filter" }
  }
}
