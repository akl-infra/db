{
  "request": {
    "method": "POST",
    "path": "/v1/webhooks",
    "bearer": "conformance-owner2-token",
    "body": { "url": "https://receiver.example/hook", "secret": "short" }
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "body": { "error": "bad_request", "message": "invalid 'secret' (must be 16-256 characters)", "param": "/secret" }
  }
}
