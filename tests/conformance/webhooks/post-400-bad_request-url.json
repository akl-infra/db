{
  "request": {
    "method": "POST",
    "path": "/v1/webhooks",
    "bearer": "conformance-owner2-token",
    "body": { "url": "http://receiver.example/hook", "secret": "conformance-webhook-secret-1" }
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "body": { "error": "bad_request", "message": "invalid 'url' (must be https://)", "param": "/url" }
  }
}
