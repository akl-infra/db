{
  "request": {
    "method": "POST",
    "path": "/v1/layouts",
    "bearer": "conformance-owner-token",
    "body": {
      "name": "cw-post-badpayload-1",
      "format": "spark/1",
      "payload": {
        "board": {
          "kind": "not-a-kind"
        },
        "keys": []
      }
    }
