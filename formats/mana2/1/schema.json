{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akl-db/formats/mana2/1/schema.json",
  "title": "mana2/1 payload",
  "description": "A parsed mana2 .jsonc layout object (12-implementation-phase5.md §0.4/§2.5, replacing 01-format.md §6.3). additionalProperties:false at every level -- a future mana2 key is a mana2/2, not a silent pass. Grammar (token shape, duplicate chars, row-shape agreement, stagger length) and cross-field rules live in formats/mana2/1/index.ts's validate(), not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout", "fingermap", "board"],
  "properties": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingers"],
      "properties": {
        "fingers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 5
        },
        "thumbs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "maxItems": 2
        }
      }
    },
    "fingermap": {
      "type": "array",
      "items": { "type": "string" }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowOrColumnStagger"],
      "properties": {
        "isRowStaggered": { "type": "boolean" },
        "mirrorLeftRowStagger": { "type": "boolean" },
        "splitAngle": { "type": "number" },
        "rowOrColumnStagger": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "magic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "magicKeys": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "combos": {
      "type": "array",
      "items": { "$ref": "#/$defs/combo" }
    },
    "layers": {}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "output"],
      "properties": {
        "inputs": { "type": "string", "minLength": 2 },
        "output": { "type": "string", "minLength": 1 }
      }
    },
    "combo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "output"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "output": { "type": "string", "minLength": 1 }
      }
    }
  }
}
