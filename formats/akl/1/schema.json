{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akl-db/formats/akl/1/schema.json",
  "title": "akl/1 payload",
  "description": "The common format (01-format.md §2): cmini's keys map, #261's board geometry, the magic-rules authoring shape from design/magic-rules/02-schema.md, plus a raw-rule escape hatch and a free-form `x`. Single-code-point-ness, cross-field agreement and referential checks (a magic key names a real layout key, etc.) are NOT expressible here -- they live in formats/akl/1/index.ts's validate().",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys"],
  "properties": {
    "keys": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/position" }
    },
    "free": {
      "type": "array",
      "items": { "$ref": "#/$defs/position" }
    },
    "board": { "$ref": "#/$defs/board" },
    "magic": { "$ref": "#/$defs/magic" },
    "x": { "type": "object" }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "col", "finger"],
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 4 },
        "col": { "type": "integer", "minimum": 0 },
        "finger": {
          "enum": ["LP", "LR", "LM", "LI", "RI", "RM", "RR", "RP", "LT", "RT", "TB"]
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["rowstag", "colstag", "ortho"] },
        "stagger": {
          "type": "array",
          "items": { "type": "number" }
        },
        "cmini": { "enum": ["stagger", "angle", "ortho", "mini"] }
      }
    },
    "magic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "magic_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/magicKey" }
        },
        "chiral_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/chiralKey" }
        },
        "adaptive_swaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/adaptiveSwap" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rawRule" }
        }
      }
    },
    "magicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "default": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/magicKeyRule" }
        },
        "except": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "magicKeyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "output"],
      "properties": {
        "after": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    "chiralKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "same": { "type": "string" },
        "opposite": { "type": "string" },
        "except": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "adaptiveSwap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "swap"],
      "properties": {
        "trigger": { "type": "string" },
        "swap": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "rawRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "output"],
      "properties": {
        "inputs": { "type": "string", "minLength": 2 },
        "output": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
