{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akl-db/formats/spark/1/schema.json",
  "title": "spark/1 payload",
  "description": "The common format (design/layout-db/22-spark-spec.md, design/layout-db/23-geometry.md §4): cmini's positions, the board geometry #261/23-geometry.md introduced (one required word -- ansi, iso, ortho or colstag; no stagger amounts, no split, they're derived, §4.1), the magic-rules authoring shape from design/magic-rules/02-schema.md, plus a raw-rule escape hatch. 21-formats.md D10 dropped the free-form `x` field; 23-geometry.md dropped the `board` object (kind/stagger/cmini) and the `TB` finger (§4.2: a thumb key's label IS its hand), and its own duplicate-characters follow-up replaced the char-keyed `keys` map (plus a separate `free` array) with ONE array of positions -- `char` optional (absent = free), and the SAME char may appear on more than one entry. Single-code-point-ness, cross-field agreement and referential checks (no two entries share (row, col), a magic-named char has at most one entry, the iso width rule, etc.) are NOT expressible here -- they live in formats/spark/1/index.ts's validate().",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "board"],
  "properties": {
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/key" }
    },
    "board": { "enum": ["ansi", "iso", "ortho", "colstag"] },
    "magic": { "$ref": "#/$defs/magic" }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "col", "finger"],
      "properties": {
        "char": { "type": "string" },
        "row": { "type": "integer", "minimum": 0, "maximum": 4 },
        "col": { "type": "integer", "minimum": 0 },
        "finger": {
          "enum": ["LP", "LR", "LM", "LI", "RI", "RM", "RR", "RP", "LT", "RT"]
        }
      }
    },
    "magic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "magic_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/magicKey" }
        },
        "chiral_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/chiralKey" }
        },
        "adaptive_swaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/adaptiveSwap" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rawRule" }
        }
      }
    },
    "magicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "default": { "$ref": "#/$defs/magicDefault" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/magicKeyRule" }
        },
        "except": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "magicDefault": {
      "description": "design/layout-db/24-spark-wire-review.md finding 6, round 2's resolution item 1: a `kind`-discriminated tagged union, not bare strings -- absent means none (there is no 'none' tag).",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "repeat" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "char"], "properties": { "kind": { "const": "char" }, "char": { "type": "string" } } }
      ]
    },
    "chiralValue": {
      "description": "design/layout-db/24-spark-wire-review.md finding 6, round 2's resolution item F: the SAME kind-tagged union as magicDefault -- a literal character is `{kind:\"char\",char}`, never a bare string; the 'repeat previous' sentinel is `{kind:\"repeat\"}`.",
      "$ref": "#/$defs/magicDefault"
    },
    "magicKeyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "output"],
      "properties": {
        "after": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    "chiralKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "same": { "oneOf": [{ "$ref": "#/$defs/chiralValue" }, { "type": "null" }] },
        "opposite": { "oneOf": [{ "$ref": "#/$defs/chiralValue" }, { "type": "null" }] },
        "except": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "adaptiveSwap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "swap"],
      "properties": {
        "trigger": { "type": "string" },
        "swap": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "rawRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "output"],
      "properties": {
        "inputs": { "type": "string", "minLength": 2 },
        "output": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
