{
  "name": "@akl/layout-formats",
  "version": "0.1.0",
  "description": "Keyboard-layout payload formats (cmini/1, akl/1, mana2/1): schema, validate, lower, and the to/from translations between them. The pure format registry akl-db's Worker wraps (12 §3 X5 item 1).",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "*/*/schema.json",
    "*/*/README.md",
    "*/*/OWNERS"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cmini/1": {
      "types": "./dist/cmini/1/index.d.ts",
      "import": "./dist/cmini/1/index.js"
    },
    "./akl/1": {
      "types": "./dist/akl/1/index.d.ts",
      "import": "./dist/akl/1/index.js"
    },
    "./mana2/1": {
      "types": "./dist/mana2/1/index.d.ts",
      "import": "./dist/mana2/1/index.js"
    },
    "./cmini/1/schema.json": "./cmini/1/schema.json",
    "./akl/1/schema.json": "./akl/1/schema.json",
    "./mana2/1/schema.json": "./mana2/1/schema.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup"
  }
}
